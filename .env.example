# Required
KEHRIBAR_ADMIN_USERNAME=admin
KEHRIBAR_ADMIN_PASSWORD=change-me
# 64 hex characters; generate with: openssl rand -hex 32
KEHRIBAR_SECRET_KEY=

# Optional (defaults shown)
# Empty listens on [::]:8600 (IPv6 and IPv4), or on 0.0.0.0:8600 without IPv6
KEHRIBAR_LISTEN_ADDR=
KEHRIBAR_DATA_DIR=/data
KEHRIBAR_SYNC_INTERVAL_MINUTES=360
KEHRIBAR_SYNC_CONCURRENCY=2
KEHRIBAR_GIT_TIMEOUT_SECONDS=3600
KEHRIBAR_SESSION_TTL_HOURS=168
# Set to true when the app is served over HTTPS
KEHRIBAR_COOKIE_SECURE=false
KEHRIBAR_LOG_LEVEL=info
# Reverse proxies whose X-Forwarded-For names the client, for example
# 10.0.0.0/8; failed logins then count per client, not per proxy
KEHRIBAR_TRUSTED_PROXIES=

# Maintenance: days between two git fsck / git repack runs; 0 turns it off
KEHRIBAR_FSCK_INTERVAL_DAYS=7
KEHRIBAR_REPACK_INTERVAL_DAYS=7

# Address of the web interface: notifications link to the repository page
# with it, and push webhook URLs start with it
KEHRIBAR_PUBLIC_URL=

# Notifications
KEHRIBAR_NOTIFY_WEBHOOK_URL=
KEHRIBAR_NOTIFY_TELEGRAM_BOT_TOKEN=
KEHRIBAR_NOTIFY_TELEGRAM_CHAT_ID=
KEHRIBAR_NOTIFY_TELEGRAM_API_URL=https://api.telegram.org
# tr or en
KEHRIBAR_NOTIFY_LANG=tr

# Backups to S3-compatible storage; all four of endpoint, bucket and keys
# are needed. Set PATH_STYLE to true for MinIO and most self-hosted storage.
KEHRIBAR_BACKUP_S3_ENDPOINT=
KEHRIBAR_BACKUP_S3_REGION=us-east-1
KEHRIBAR_BACKUP_S3_BUCKET=
KEHRIBAR_BACKUP_S3_PREFIX=
KEHRIBAR_BACKUP_S3_ACCESS_KEY_ID=
KEHRIBAR_BACKUP_S3_SECRET_ACCESS_KEY=
KEHRIBAR_BACKUP_S3_PATH_STYLE=false
KEHRIBAR_BACKUP_INTERVAL_HOURS=24
KEHRIBAR_BACKUP_KEEP=7
