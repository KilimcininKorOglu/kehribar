# Required
GIT_ARCHIVE_ADMIN_USERNAME=admin
GIT_ARCHIVE_ADMIN_PASSWORD=change-me
# 64 hex characters; generate with: openssl rand -hex 32
GIT_ARCHIVE_SECRET_KEY=

# Optional (defaults shown)
GIT_ARCHIVE_LISTEN_ADDR=0.0.0.0:8600
GIT_ARCHIVE_DATA_DIR=/data
GIT_ARCHIVE_SYNC_INTERVAL_MINUTES=360
GIT_ARCHIVE_SYNC_CONCURRENCY=2
GIT_ARCHIVE_GIT_TIMEOUT_SECONDS=3600
GIT_ARCHIVE_SESSION_TTL_HOURS=168
# Set to true when the app is served over HTTPS
GIT_ARCHIVE_COOKIE_SECURE=false
GIT_ARCHIVE_LOG_LEVEL=info
