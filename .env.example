# Required
GIT_ARCHIVE_ADMIN_USERNAME=admin
GIT_ARCHIVE_ADMIN_PASSWORD=change-me
# 64 hex characters; generate with: openssl rand -hex 32
GIT_ARCHIVE_SECRET_KEY=

# Optional (defaults shown)
# Empty listens on [::]:8600 (IPv6 and IPv4), or on 0.0.0.0:8600 without IPv6
GIT_ARCHIVE_LISTEN_ADDR=
GIT_ARCHIVE_DATA_DIR=/data
GIT_ARCHIVE_SYNC_INTERVAL_MINUTES=360
GIT_ARCHIVE_SYNC_CONCURRENCY=2
GIT_ARCHIVE_GIT_TIMEOUT_SECONDS=3600
GIT_ARCHIVE_SESSION_TTL_HOURS=168
# Set to true when the app is served over HTTPS
GIT_ARCHIVE_COOKIE_SECURE=false
GIT_ARCHIVE_LOG_LEVEL=info

# Maintenance: days between two git fsck / git repack runs; 0 turns it off
GIT_ARCHIVE_FSCK_INTERVAL_DAYS=7
GIT_ARCHIVE_REPACK_INTERVAL_DAYS=7

# Address of the web interface: notifications link to the repository page
# with it, and push webhook URLs start with it
GIT_ARCHIVE_PUBLIC_URL=

# Notifications
GIT_ARCHIVE_NOTIFY_WEBHOOK_URL=
GIT_ARCHIVE_NOTIFY_TELEGRAM_BOT_TOKEN=
GIT_ARCHIVE_NOTIFY_TELEGRAM_CHAT_ID=
GIT_ARCHIVE_NOTIFY_TELEGRAM_API_URL=https://api.telegram.org
# tr or en
GIT_ARCHIVE_NOTIFY_LANG=tr

# Backups to S3-compatible storage; all four of endpoint, bucket and keys
# are needed. Set PATH_STYLE to true for MinIO and most self-hosted storage.
GIT_ARCHIVE_BACKUP_S3_ENDPOINT=
GIT_ARCHIVE_BACKUP_S3_REGION=us-east-1
GIT_ARCHIVE_BACKUP_S3_BUCKET=
GIT_ARCHIVE_BACKUP_S3_PREFIX=
GIT_ARCHIVE_BACKUP_S3_ACCESS_KEY_ID=
GIT_ARCHIVE_BACKUP_S3_SECRET_ACCESS_KEY=
GIT_ARCHIVE_BACKUP_S3_PATH_STYLE=false
GIT_ARCHIVE_BACKUP_INTERVAL_HOURS=24
GIT_ARCHIVE_BACKUP_KEEP=7
